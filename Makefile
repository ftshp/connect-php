.PHONY: check fix test stan cs generate conformance conformance-install conformance-server conformance-client mutation

# Composer's vendor/ would otherwise switch the go command into vendor mode.
export GOFLAGS := -mod=readonly

# conformance/src needs the classes generated by conformance-install.
PHPSTAN_CONF := $(if $(wildcard conformance/gen),-c conformance/phpstan.neon)

check:
	composer validate --strict
	composer normalize --dry-run
	vendor/bin/composer-dependency-analyser
	vendor/bin/php-cs-fixer check --diff
	vendor/bin/phpstan analyse $(PHPSTAN_CONF)
	vendor/bin/phpunit
	go vet ./... && test -z "$$(gofmt -l .)" && go test ./...

fix:
	vendor/bin/php-cs-fixer fix

test:
	vendor/bin/phpunit

stan:
	vendor/bin/phpstan analyse $(PHPSTAN_CONF)

cs:
	vendor/bin/php-cs-fixer check --diff

generate:
	go build -o build/protoc-gen-connect-php ./cmd/protoc-gen-connect-php
	buf generate

# nhooyr.io no longer resolves, so a direct fetch of the runner's dependencies fails.
conformance-install:
	go build -o build/protoc-gen-connect-php ./cmd/protoc-gen-connect-php
	cd conformance && composer install && buf generate
	GOBIN=$(CURDIR)/build/bin GOPROXY=https://proxy.golang.org,direct go install connectrpc.com/conformance/cmd/connectconformance@v1.0.7

conformance-server:
	build/bin/connectconformance --conf conformance/config.yaml --mode server --known-failing @conformance/known-failing.txt -- php conformance/server.php

conformance-client:
	build/bin/connectconformance --conf conformance/config.yaml --mode client --known-failing @conformance/known-failing-client.txt -- php conformance/client.php

conformance: conformance-server conformance-client

mutation:
	vendor/bin/infection --threads=max --min-msi=70 --min-covered-msi=80
