{
    "name": "ftshp/connect",
    "description": "A PHP implementation of the Connect protocol: PSR-18 client, PSR-15 server and a protoc plugin",
    "license": "Apache-2.0",
    "type": "library",
    "keywords": [
        "connect",
        "rpc",
        "protobuf",
        "psr-18",
        "psr-15"
    ],
    "authors": [
        {
            "name": "Rastislav Nemec"
        }
    ],
    "homepage": "https://github.com/ftshp/connect-php",
    "support": {
        "issues": "https://github.com/ftshp/connect-php/issues",
        "source": "https://github.com/ftshp/connect-php"
    },
    "require": {
        "php": "^8.5",
        "ext-zlib": "*",
        "google/protobuf": "^5.36",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.1",
        "psr/http-message": "^2.0",
        "psr/http-server-handler": "^1.0"
    },
    "require-dev": {
        "ergebnis/composer-normalize": "^2.47",
        "friendsofphp/php-cs-fixer": "^3.90",
        "infection/infection": "^0.35",
        "nyholm/psr7": "^1.8.2",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.3",
        "phpstan/phpstan-deprecation-rules": "^2",
        "phpstan/phpstan-phpunit": "^2",
        "phpstan/phpstan-strict-rules": "^2",
        "phpunit/phpunit": "^13",
        "shipmonk/composer-dependency-analyser": "^1.8"
    },
    "autoload": {
        "psr-4": {
            "Ftshp\\Connect\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ftshp\\Connect\\Test\\": "tests/Generated/Ftshp/Connect/Test/",
            "Ftshp\\Connect\\Tests\\": "tests/",
            "GPBMetadata\\": "tests/Generated/GPBMetadata/"
        }
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true,
            "infection/extension-installer": false,
            "phpstan/extension-installer": true
        },
        "sort-packages": true
    },
    "scripts": {
        "cs": "php-cs-fixer check --diff",
        "cs-fix": "php-cs-fixer fix",
        "stan": "phpstan",
        "test": "phpunit"
    }
}
