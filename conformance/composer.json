{
    "name": "ftshp/connect-conformance",
    "description": "Conformance test programs for ftshp/connect",
    "license": "Apache-2.0",
    "type": "project",
    "require": {
        "php": "^8.4",
        "ext-pcntl": "*",
        "ext-posix": "*",
        "ftshp/connect": "@dev",
        "guzzlehttp/guzzle": "^8.3",
        "nyholm/psr7": "^1.8.2",
        "nyholm/psr7-server": "^1.1"
    },
    "repositories": [
        {
            "type": "path",
            "url": "..",
            "options": {
                "symlink": true
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "Connectrpc\\Conformance\\V1\\": "gen/Connectrpc/Conformance/V1/",
            "Ftshp\\Connect\\Conformance\\": "src/",
            "GPBMetadata\\": "gen/GPBMetadata/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
